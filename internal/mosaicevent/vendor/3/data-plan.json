{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mosaic-finance.com/schemas/mosaic-event/3/data-plan.json",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "completed"
            ]
          },
          "_meta": {
            "type": "object"
          }
        },
        "required": [
          "content",
          "priority",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "_meta": {
      "type": "object"
    }
  },
  "required": [
    "entries"
  ],
  "additionalProperties": false
}
