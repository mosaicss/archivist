{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mosaic-finance.com/schemas/mosaic-event/3/data-artifact.json",
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mediaType": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "artifactId",
    "name",
    "mediaType",
    "url",
    "digest"
  ],
  "additionalProperties": false
}
