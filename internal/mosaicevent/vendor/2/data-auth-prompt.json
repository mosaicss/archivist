{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mosaic-finance.com/schemas/mosaic-event/2/data-auth-prompt.json",
  "type": "object",
  "properties": {
    "promptId": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "message": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[!-~]+$"
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "promptId",
    "provider",
    "message"
  ],
  "additionalProperties": false
}
