{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mosaic-finance.com/schemas/mosaic-event/2/data-session-status.json",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "starting",
        "ready",
        "running",
        "completed",
        "failed",
        "interrupted",
        "disconnected",
        "lost"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "sessionId",
    "status"
  ],
  "additionalProperties": false
}
