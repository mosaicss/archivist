{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TableSearchBody",
  "description": "Request body schema for /table/search, /table/add-rows, /table/add-column. Mirrors the Zod schemas in chat-api/src/routes/table.ts:57-178.",
  "type": "object",
  "required": [
    "rows",
    "columns",
    "top_n"
  ],
  "additionalProperties": false,
  "properties": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Row"
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Column"
      }
    },
    "top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "source_offset": {
      "type": "integer",
      "minimum": 0
    }
  },
  "definitions": {
    "DateString": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD format"
    },
    "Filters": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "issuer_key": {
          "type": "string",
          "minLength": 1
        },
        "formtype": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 50
            }
          ]
        },
        "formdescription": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 50
            }
          ]
        },
        "date_from": {
          "$ref": "#/definitions/DateString"
        },
        "date_to": {
          "$ref": "#/definitions/DateString"
        },
        "exchange": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 20
            }
          ]
        },
        "sector": {
          "type": "string",
          "minLength": 1
        },
        "industry": {
          "type": "string",
          "minLength": 1
        },
        "custom_entity": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Row": {
      "type": "object",
      "required": [
        "filters"
      ],
      "additionalProperties": false,
      "properties": {
        "filters": {
          "$ref": "#/definitions/Filters"
        },
        "issuer_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "issuer_symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "FilingsColumn": {
      "type": "object",
      "required": [
        "name",
        "retrieval_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "filings"
          ]
        },
        "retrieval_mode": {
          "type": "string",
          "enum": [
            "rrf",
            "vector",
            "keyword"
          ]
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "semantic_query": {
          "type": "string",
          "minLength": 1
        },
        "keyword_query": {
          "type": "string",
          "minLength": 1
        },
        "web_query": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "WebColumn": {
      "type": "object",
      "required": [
        "name",
        "source",
        "web_query"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "web"
          ]
        },
        "retrieval_mode": {
          "type": "string",
          "enum": [
            "web"
          ]
        },
        "web_query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "Column": {
      "oneOf": [
        {
          "$ref": "#/definitions/WebColumn"
        },
        {
          "$ref": "#/definitions/FilingsColumn"
        }
      ]
    }
  }
}
